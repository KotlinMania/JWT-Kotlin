/**
 * cinterop definition for the project's native C wrapper.
 *
 * Transliterated from the libc-kotlin pattern
 * (kotlinmania/libc-kotlin/src/nativeInterop/cinterop/libc.def), generalized:
 * headers are project-authored and named here; ffi_wrapper.h carries the
 * function declarations the cinterop tool turns into Kotlin bindings.
 *
 * - headers: the system C headers + ffi_wrapper.h. Add whatever the wrapped
 *   library needs. Keep headerFilter = * unless you need to narrow the
 *   generated surface.
 * - compilerOpts: include path so `#include "ffi_wrapper.h"` resolves when
 *   cinterop compiles the shim TU.
 * - staticLibraries: the archive produced by the compileFfiWrapperFor*
 *   Gradle tasks (see build.gradle.kts). Required — the wrapper's function
 *   bodies must link into the Kotlin binary.
 * - noStringConversion: list any wrapper function returning char* that must
 *   NOT be auto-converted to Kotlin String (because the pointer aliases the
 *   input or must be freed). See kotlinmania/libc-kotlin for the proven
 *   reason set. Template default: ffi_errno (returns an int*, not char*).
 *
 * Rename this file to <ProjectFfiName>.def to match project.ffi.name.
 */
headers = stddef.h stdint.h ffi_wrapper.h
headerFilter = *
compilerOpts = -Isrc/nativeInterop/cinterop
staticLibraries = ffi_wrapper.a
noStringConversion = ffi_errno
